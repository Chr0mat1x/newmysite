# ORBIT mail relay — real inbox delivery for the local stack.
#
# Copy to `.env.relay` (gitignored) and fill in a provider. Without these the
# relay still runs, but only reports what it would forward.
#
# Any SMTP provider works. Resend and Brevo both have free tiers:
#   RELAY_SMTP_HOST=smtp.resend.com
#   RELAY_SMTP_PORT=587
#   RELAY_SMTP_USER=resend
#   RELAY_SMTP_PASS=re_xxxxxxxx
#   RELAY_SMTP_FROM=ORBIT <orbit@yourdomain.com>
#
# `RELAY_SMTP_FROM` must be a verified sender at the provider, otherwise the
# provider will reject the message with a 5xx during MAIL FROM.
#
# While testing, RELAY_FORWARD_TO sends every message to one mailbox regardless
# of who it was addressed to — handy when your signup addresses are fake.

# Where the app is reachable. Links in the mail are rewritten to this origin.
RELAY_PUBLIC_BASE=https://work-1-fffmzaxhmllpadif.prod-runtime.all-hands.dev

# The Inbucket catcher inside the local Supabase stack.
RELAY_CATCHER_URL=http://127.0.0.1:54324

# SMTP provider.
RELAY_SMTP_HOST=
RELAY_SMTP_PORT=587
RELAY_SMTP_USER=
RELAY_SMTP_PASS=
RELAY_SMTP_FROM=
RELAY_SMTP_SECURE=false

# Optional: force every message to a single mailbox.
RELAY_FORWARD_TO=

# How often to check the catcher, in milliseconds.
RELAY_POLL_MS=3000
