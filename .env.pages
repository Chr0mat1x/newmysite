# GitHub Pages demo. Deliberately blank: the hosted demo runs on the offline
# localStorage backend so it needs no server to stay reachable. These empty
# values override whatever .env.local holds (Vite loads .env.<mode> after
# .env.local), which is what keeps the shared-galaxy URL out of the bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Offline demo: no backend, so no push. Blank keeps it out of the bundle.
VITE_VAPID_PUBLIC_KEY=
